{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clockly",
  "version": "1.0.0",
  "identifier": "com.clockly.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "url": "index.html",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "visible": true
      },
      {
        "label": "settings",
        "title": "Clockly - Settings",
        "url": "settings.html",
        "width": 880,
        "height": 680,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "shadow": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}